APP_NAME=Laravel
APP_ENV=local
APP_KEY=

# For local development set to true. In production ALWAYS set to false.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production when serving over HTTPS
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Option 1: Gmail SMTP (Active Default)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ideapbd@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=ideapbd@gmail.com
MAIL_FROM_NAME="Idea Prokashon"
MAIL_REPLY_TO_ADDRESS=ideapbd@gmail.com

# Option 2: Live Server Local Sendmail
# MAIL_MAILER=sendmail
# MAIL_HOST=127.0.0.1
# MAIL_PORT=25
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS=noreply@ideaabd.com
# MAIL_FROM_NAME="Idea Prokashon"
# MAIL_REPLY_TO_ADDRESS=ideapbd@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
LOGIN_FAILED_ATTEMPTS_FOR_CAPTCHA=3


# Reverse proxy IPs/CIDRs allowed to set X-Forwarded-* headers (comma separated). Empty = trust all (less safe).
TRUSTED_PROXIES=

# --- SMS protection (all optional; defaults shown) ---
# SMS_GUARD=true
# SMS_DAILY_LIMIT=2          # OTP per number per 24 hours, then a 24-hour lock
# SMS_LIMIT_SCOPE=otp        # otp = only OTP is limited, all = every automatic message
# SMS_NOTIFICATION_LIMIT=5   # other automatic messages per number per 24 hours (no lock)
# SMS_RESTRICT_HOURS=24
# SMS_BLOCK_AFTER_DAYS=3     # limit hit on this many different days = OTP blocked until an admin releases the number
# SMS_ALLOWED_NUMBERS=       # your own test numbers, comma separated
# SMS_COST_PER_SMS=0.35

# --- Backups (/admin/backup; all optional) ---
# BACKUP_QUOTA_MB=0          # hosting plan size in MB; 0 = the real size of the disk
# BACKUP_RETENTION=3
# BACKUP_MAX_PCT=40
# BACKUP_UPLOAD_MAX_MB=200
# BACKUP_MAIL_MAX_MB=20
# BACKUP_DIR=                # default: storage/app/backups
