<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Force HTTPS for ideaabd.com
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^(www\.)?ideaabd\.com$ [NC]
    RewriteRule ^(.*)$ https://www.ideaabd.com/$1 [L,R=301]

    # 2. Force www.ideaabd.com (Redirect non-www to www canonical)
    RewriteCond %{HTTP_HOST} ^ideaabd\.com$ [NC]
    RewriteRule ^(.*)$ https://www.ideaabd.com/$1 [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# cPanel / Apache PHP Upload & Resource Directives
<IfModule mod_php.c>
    php_value upload_max_filesize 256M
    php_value post_max_size 256M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 256M
    php_value post_max_size 256M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# ── Hardening ────────────────────────────────────────────────────────────────
# Never serve hidden files (.env, .git …) or leftovers such as dumps, backups and logs.
<FilesMatch "(^\.(?!well-known)|\.(sql|bak|old|orig|swp|log|ini|sh|md|lock|dist)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Uploaded files are data, never programs: refuse to run scripts that live in upload folders.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(storage|images|uploads|media)/.*\.(php\d?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp)$ - [F,L,NC]
</IfModule>

# Browser safety headers for everything Apache serves directly (images, scripts, fonts).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always unset X-Powered-By
</IfModule>
ServerSignature Off
